<style>
    /* Shared visual system: clinical editorial pages + compact research console. */
    :root {
        --ra-accent: #b56c1e;
        --ra-accent-deep: #8f5013;
        --ra-accent-blue: #6f42c1;
        --ra-blue: #6f42c1;
        --ra-title: #162033;
        --ra-text: #627089;
        --ra-line: #d8dde3;
        --ra-line-soft: #e7edf5;
    }

    .ra-platform-home .ra-banner--overview {
        min-height: clamp(500px, 48vw, 680px);
    }

    .ra-platform-home .ra-banner-copy {
        width: min(100%, 940px);
        max-width: min(72%, 940px);
    }

    .ra-platform-home .ra-hero-title {
        max-width: 18ch;
        font-size: clamp(3rem, 4.4vw, 4.25rem);
        line-height: .98;
    }

    .ra-platform-home .ra-hero-desc {
        max-width: 62ch;
    }

    .ra-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .7rem;
        margin-top: 1.65rem;
    }

    .ra-hero-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 1.1rem;
        border: 1px solid rgba(255, 255, 255, .42);
        border-radius: 6px;
        font-size: .9rem;
        font-weight: 800;
        letter-spacing: .01em;
        text-decoration: none !important;
        transition: transform .18s ease, background .18s ease, border-color .18s ease;
    }

    .ra-hero-action:hover {
        transform: translateY(-2px);
    }

    .ra-hero-action--primary {
        border-color: var(--ra-accent-deep);
        background: var(--ra-accent-deep);
        color: #fff !important;
    }

    .ra-hero-action--primary:hover {
        border-color: #70400f;
        background: #70400f;
    }

    .ra-hero-action--secondary {
        background: rgba(25, 21, 31, .46);
        color: #fff !important;
        backdrop-filter: blur(8px);
    }

    .ra-hero-action--secondary:hover {
        border-color: #fff;
        background: rgba(25, 21, 31, .68);
    }

    .ra-platform-home .ra-banner--section {
        min-height: clamp(300px, 27vw, 400px);
    }

    .ra-platform-home .ra-banner-inner--compact {
        padding-block: clamp(2.25rem, 5vh, 3.75rem);
    }

    .ra-platform-home .ra-section-banner-copy {
        grid-template-columns: minmax(10rem, 15rem) minmax(0, 1fr);
        column-gap: clamp(1.75rem, 4vw, 4rem);
    }

    .ra-platform-home .ra-section-banner-copy .ra-section-title {
        max-width: 16ch;
        font-size: clamp(2.5rem, 4vw, 4.35rem);
        line-height: .98;
    }

    .ra-platform-home .ra-module-body {
        padding-block: clamp(3.25rem, 6vw, 5.5rem);
    }

    .ra-platform-home .ra-cap-item {
        border: 1px solid rgba(216, 221, 227, .9);
        border-radius: 10px;
        box-shadow: 0 12px 30px rgba(47, 52, 64, .055);
    }

    /* Task pages use shorter headers and denser control/data regions. */
    .ra-platform-home,
    .ra-jobs-page {
        overflow-x: visible;
    }

    .ra-header-hero {
        margin-bottom: .75rem;
    }

    .ra-header-hero .ra-banner--overview,
    .ra-jobs-page .ra-banner--overview {
        min-height: clamp(300px, 34vw, 440px);
    }

    .ra-header-hero .ra-banner-inner,
    .ra-jobs-page .ra-banner-inner {
        padding-block: clamp(2.25rem, 5vw, 4rem);
    }

    .ra-header-hero .ra-banner-copy,
    .ra-jobs-page .ra-banner-copy {
        max-width: min(56%, 680px);
    }

    .ra-header-hero .ra-hero-title,
    .ra-jobs-page .ra-hero-title {
        max-width: 12ch;
        font-size: clamp(2.6rem, 4.7vw, 4.85rem);
        line-height: .98;
    }

    .ra-banner-overlay--target {
        background:
            linear-gradient(90deg, rgba(255, 255, 255, .98) 0%, rgba(255, 255, 255, .94) 42%, rgba(255, 255, 255, .46) 67%, rgba(255, 255, 255, .08) 100%),
            linear-gradient(0deg, rgba(47, 52, 64, .08), transparent 45%);
    }

    .ra-editorial-head.mb-5 {
        margin-bottom: 1.5rem !important;
    }

    .ra-hero-title-docking {
        font-size: clamp(2rem, 3.8vw, 3.7rem);
        line-height: 1.02;
    }

    .ra-toolbar {
        padding: 1rem;
        border-color: var(--ra-line);
        border-radius: 16px;
        box-shadow: 0 10px 28px rgba(47, 52, 64, .055);
    }

    .ra-search,
    .ra-sort-select {
        min-height: 44px;
        border-radius: 8px;
    }

    .ra-search:focus,
    .ra-sort-select:focus {
        border-color: var(--ra-blue);
        box-shadow: 0 0 0 3px rgba(111, 66, 193, .12);
    }

    .ra-search::placeholder {
        color: #6b7280;
    }

    .ra-view-toggle,
    .ra-page-size {
        gap: .25rem;
        padding: .25rem;
        border-radius: 9px;
    }

    .ra-page-size-label {
        padding: 0 .4rem 0 .25rem;
        color: var(--ra-text);
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

    .ra-toggle-btn,
    .ra-size-btn {
        min-height: 34px;
        border-radius: 7px;
    }

    .ra-category-panel,
    .ra-category-row,
    .ra-category-row--main {
        gap: .5rem;
    }

    .ra-category-chip {
        min-height: 40px;
        padding-inline: .85rem;
        border-radius: 8px;
        color: var(--ra-accent);
        font-size: .86rem;
    }

    .ra-results-block,
    .ra-table-view,
    .ra-card-view {
        min-width: 0;
        max-width: 100%;
    }

    .ra-results-block {
        gap: 1rem;
    }

    .ra-results-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        border-bottom: 1px solid var(--ra-line);
        padding-bottom: .75rem;
    }

    .ra-results-title {
        margin: 0;
        font-size: clamp(2rem, 3.5vw, 3.2rem);
    }

    .ra-result-summary {
        margin: 0;
        color: var(--ra-text);
        font-size: .9rem;
        font-weight: 700;
    }

    .ra-table-view {
        overflow: hidden;
    }

    .ra-table-shell {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        border-radius: 12px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .ra-table {
        min-width: 920px;
    }

    .ra-table th,
    .ra-table thead th {
        padding: .72rem .78rem;
        font-size: .75rem;
    }

    .ra-table td,
    .ra-table tbody td {
        padding: .64rem .78rem;
    }

    .ra-table-thumb {
        width: 56px;
        border-radius: 8px;
    }

    .ra-table-meta,
    .ra-ref-links,
    .ra-meta {
        font-size: .86rem;
        line-height: 1.45;
    }

    .ra-target-card {
        border-radius: 14px;
    }

    /* Docking controls keep the site's established purple accent, independent of page bundle order. */
    .ra-docking-page .ra-step-badge,
    .ra-docking-page .ra-ligand-tab-index {
        background: #f3eef9;
        color: #6f42c1;
    }

    .ra-docking-page .ra-ligand-tab:hover,
    .ra-docking-page .ra-ligand-tab:focus,
    .ra-docking-page .ra-ligand-tab.active {
        border-color: rgba(111, 66, 193, .55);
    }

    .ra-docking-page .ra-ligand-tab.active {
        background: #f3eef9;
    }

    .ra-docking-page .form-control:focus {
        border-color: rgba(111, 66, 193, .42);
        box-shadow: 0 0 0 .2rem rgba(111, 66, 193, .09);
    }

