        .ra-header-hero .ra-banner img {
            object-position: 74% center;
            opacity: .66;
        }

        .ra-header-hero .ra-hero-title,
        .ra-jobs-page .ra-hero-title {
            max-width: 11ch;
            font-size: clamp(2.25rem, 11vw, 3.25rem);
        }

        .ra-toolbar {
            padding: .75rem;
        }

        .ra-controls,
        .ra-view-toggle,
        .ra-page-size {
            width: 100%;
        }

        .ra-view-toggle > *,
        .ra-page-size .ra-size-btn {
            flex: 1;
        }

        .ra-category-chip {
            justify-content: flex-start;
            min-height: 42px;
        }

        .ra-results-heading {
            align-items: flex-end;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ra-platform-home *,
        .ra-jobs-page * {
            scroll-behavior: auto !important;
            transition-duration: .01ms !important;
        }
    }
</style>
