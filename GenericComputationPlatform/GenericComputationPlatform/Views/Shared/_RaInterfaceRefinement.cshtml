        .ra-hero-actions,
        .ra-hero-action {
            width: 100%;
        }

        .ra-platform-home .ra-banner--section {
            min-height: clamp(300px, 83vw, 390px);
        }

        .ra-platform-home .ra-section-banner-copy .ra-section-title {
            max-width: 12ch;
            font-size: clamp(2.1rem, 9.5vw, 3.1rem);
        }

        .ra-header-hero .ra-banner--overview,
        .ra-jobs-page .ra-banner--overview {
            min-height: 390px;
        }

        .ra-banner-overlay--target {
            background: linear-gradient(90deg, rgba(255, 255, 255, .98) 0%, rgba(255, 255, 255, .91) 70%, rgba(255, 255, 255, .72) 100%);
