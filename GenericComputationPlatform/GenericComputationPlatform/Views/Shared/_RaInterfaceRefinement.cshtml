        .ra-header-hero .ra-banner-copy,
        .ra-jobs-page .ra-banner-copy {
            max-width: min(100%, 42rem);
        }

        .ra-platform-home .ra-section-banner-copy {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        html,
        body {
            overflow-x: clip;
        }

        .ra-platform-home,
        .ra-jobs-page {
            overflow-x: visible;
        }

        .ra-platform-home .ra-banner--overview {
            min-height: 520px;
        }

        .ra-platform-home .ra-hero-title {
            max-width: 12ch;
            font-size: clamp(2.25rem, 10.5vw, 3.3rem);
