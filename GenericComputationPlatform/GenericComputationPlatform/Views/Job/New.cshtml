@model Domain
@inject IOptions<AppSettings> _appSettings
@using System.Linq

@{
    ViewData["Title"] = "Docking Workspace";

    int maxLigands = _appSettings.Value.Options.MaxInputLigands;
    string userName = "John";
    //add2
    var proteins = ViewBag.Proteins as IEnumerable<Protein> ?? Enumerable.Empty<Protein>();

    if (User.Identity.IsAuthenticated && !string.IsNullOrEmpty(User.Identity.Name))
    {
        int idx = User.Identity.Name.IndexOf('@');
        if (idx > 0)
            userName = User.GetFirstName();
    }
}

@section Menu {
    @{
        ViewData["ActiveMenu"] = "docking";
    }
    <partial name="_RaWorkspaceMenu" />
    <li class="nav-item nav-item-with-separator">
        <a class="nav-link" asp-controller="Job" asp-action="List" asp-route-domainId="@Model.Id">All Jobs</a>
    </li>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pageFeatures.css" asp-append-version="true" />
}


<h1 class="ra-hero-title-docking">RA Docking workspace</h1>
<hr />

<form class="ra-docking-form" asp-controller="Job" asp-action="Create" asp-route-domainId="@Model.Id" asp-antiforgery="true" method="post">
    <div class="form-group row job-name-row">
        <label class="col-sm-2 col-form-label" for="jobName">
            <span class="ra-step-badge mr-2">1</span>
            <strong>Job Name</strong>
        </label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="jobName" name="jobName" placeholder="e.g. @userName's drug01-@Model.Id.ToUpper()" />
            <div class="alert alert-danger fade collapse mt-2" role="alert" id="jobNameRequired">
                <strong>Job Name</strong> is required.
            </div>
            <small class="form-text text-muted">Provide a mnemonic name of the job for your convenience. Visible to the public.</small>
        </div>
    </div>

    <div id="ligandTabs" class="ra-ligand-tabs" role="tablist" aria-label="Ligand entries"></div>
    <div id="ligandRows" class="ra-ligand-rows"></div>

    <div class="form-group row mt-4 target-scope-row">
        <label class="col-sm-2 col-form-label">
            <span class="ra-step-badge mr-2">3</span>
            <strong>Target scope</strong>
        </label>
        <div class="col-sm-10">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="targetMode" id="targetModeAll" value="all" checked />
                <label class="form-check-label" for="targetModeAll">
                    One-click all RA targets (default)
                </label>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="targetMode" id="targetModeSelected" value="selected" />
                <label class="form-check-label" for="targetModeSelected">
                    Dock with selected targets only
                </label>
            </div>

            <div id="targetSelectionTools" class="ra-target-tools" style="display:none;">
                <div class="ra-target-search">
                    <label class="sr-only" for="targetSearchInput">Search targets</label>
                    <input id="targetSearchInput"
                           type="search"
                           class="form-control form-control-sm"
                           placeholder="Search by gene symbol, target ID, or approved name..." />
                </div>
                <div class="ra-target-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="targetSelectVisible">Select visible</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="targetClearAll">Clear all</button>
                    <span class="ra-target-count" id="targetSelectionCount">0 selected</span>
                </div>
            </div>

            <div id="targetSelectionPanel" class="border rounded p-2" style="max-height:220px; overflow:auto; display:none;">
                @foreach (var protein in proteins.OrderBy(o => o.Id))
                {
                    <div class="form-check target-option"
                         data-target-search="@($"{protein.GeneSymbol} {protein.Id} {protein.ProteinName}".ToLowerInvariant())">
                        <input class="form-check-input target-checkbox"
                               type="checkbox"
                               id="target-@protein.Id"
                               name="selectedProteinIds"
                               value="@protein.Id" />
                        <label class="form-check-label" for="target-@protein.Id">
                            <strong>@protein.GeneSymbol</strong>
                            <span class="text-muted">(target ID: @protein.Id)</span>
                            <span class="target-approved-name">@protein.ProteinName</span>
                        </label>
                    </div>
                }
            </div>

            <div class="alert alert-danger fade collapse mt-2" role="alert" id="targetRequired">
                Please select at least one target when using <strong>selected targets</strong> mode.
            </div>

            <small class="form-text text-muted">
                Keep default for full-panel docking, or switch to selected mode for custom target subsets.
            </small>
        </div>
    </div>

    <div class="form-group row mt-4 ra-submit-row">
        <label class="col-sm-2 col-form-label">
            <span class="ra-step-badge mr-2">4</span>
            <strong>Submit</strong>
        </label>
        <div class="col-sm-10 pt-1">
            <a asp-controller="Job" asp-action="Details" asp-route-domainId="@Model.Id" asp-route-jobId="0" class="d-none"></a>
            <button id="create" class="btn btn-warning font-weight-bold px-4 shadow-sm">Create Job</button>
            <button id="addmol" class="btn btn-primary ml-2 shadow-sm">Add Molecule</button>
            @if (User.Identity.IsAuthenticated)
            {
                <span class="ml-4 d-inline-block border rounded bg-light px-3 py-1">
                    <input type="checkbox" class="mr-1 mt-1" id="isPrivate" name="isPrivate" />
                    <label for="isPrivate" class="mb-0" style="cursor: pointer;" title="Only the creator can access the job. Others can only see the job name.">
                        <strong>Private job</strong>
                    </label>
                </span>
            }
            <div class="mt-2">
                <small class="form-text text-info font-weight-bold" id="formMessage"></small>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <script src="~/lib/jsme/jsme.nocache.js"></script>
    <script type="text/javascript">
        function updateTargetSelectionState() {
            const total = $(".target-checkbox").length;
            const selected = $(".target-checkbox:checked").length;
            const visible = $(".target-option:not(.target-option-hidden)").length;
            $("#targetSelectionCount").text(`${selected} selected / ${total} targets (${visible} visible)`);
        }

        function filterTargetList() {
            const query = ($("#targetSearchInput").val() || "").toString().trim().toLowerCase();
            $(".target-option").each(function () {
                const option = $(this);
                const targetText = option.attr("data-target-search") || "";
                option.toggleClass("target-option-hidden", query !== "" && targetText.indexOf(query) === -1);
            });
            updateTargetSelectionState();
        }

        function syncTargetModeUI() {
            const isSelectedMode = $("#targetModeSelected").prop("checked");
            $("#targetSelectionPanel").toggle(isSelectedMode);
            $("#targetSelectionTools").toggle(isSelectedMode);

            if (!isSelectedMode) {
                $("#targetRequired").hide().removeClass("show");
            }

            updateTargetSelectionState();
        }

        $("input[name='targetMode']").on("change", syncTargetModeUI);
        $("#targetSearchInput").on("input", filterTargetList);
        $(".target-checkbox").on("change", updateTargetSelectionState);
        $("#targetSelectVisible").on("click", function () {
            $(".target-option:not(.target-option-hidden) .target-checkbox").prop("checked", true);
            updateTargetSelectionState();
        });
        $("#targetClearAll").on("click", function () {
            $(".target-checkbox").prop("checked", false);
            updateTargetSelectionState();
        });

        filterTargetList();
        syncTargetModeUI();

        hookJobCreateButtons();
        setMaxLigands(@maxLigands);
    </script>
}
