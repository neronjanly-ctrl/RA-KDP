                                   Foreground="#333" Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="NoWrap" VerticalAlignment="Center"/>
                            </Grid>
                        </ListView.Items>
                    </ListView>

                    <Rectangle x:Name="NavPaneDivider3"
                               Grid.Row="3"
                               Grid.ColumnSpan="3"
                               Height="1"
                               Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"
                               Margin="16,6,16,6"/>

                    <ToggleButton Grid.Row="4" Grid.ColumnSpan="3"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  Checked="RatVisToggleButton_Checked"
                                  Unchecked="RatVisToggleButton_Unchecked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
