            <a href="" class="nav-link">@(_config.GetValue<string>("Manifest:HomeMenuName"))</a>
        </li>
        <li>
            <a href="#subject" class="nav-link">Subject</a>
        </li>
        <li>
            <a href="#treatment" class="nav-link">Treatment</a>
        </li>
        <li>
            <a href="#models" class="nav-link">Models</a>
        </li>
        <li>
