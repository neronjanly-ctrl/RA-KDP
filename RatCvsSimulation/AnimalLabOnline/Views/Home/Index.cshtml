<div class="body">
    <div class="m-4 w-50">
        <h1>@(_config.GetValue<string>("Manifest:Description"))</h1>

        <small class="text-muted">
            Animal experiments inflict suffering on their subjects and yield findings that are often inapplicable to humans. They are also expensive, labor-intensive, and time consuming. We developed a virtual animal & disease modeling to investigate the extremely complex interactions between drugs/molecules and proteins/cells/tissues/organs, describing and quantifying both beneficial and adverse effects. This platform integrates clinical data collected from literature, quantitative systems pharmacology and pharmacometrics approaches for calculation, simulation and prediction. Our goal is to develop an alternative, computer-simulated mathematical model to alleviate suffering of animals, as well as to mollify costs and labor of studies which use them.
        </small>
        <video width="1200" height="675" controls autoplay>
            <source src="~/images/simulation.mp4" />
        </video>
    </div>
    <a href="#" class="text-primary huge" id="next-step"><i class="fa fa-arrow-circle-down"></i></a>
    <section id="subject" class="border-top">
        <a asp-action="Subject" class="action-link d-none" data-target="#treatment" data-container="#subject-container"></a>
        <partial name="Subject" />
    </section>
    <section id="treatment" class="border-top">
        <a asp-action="Treatment" asp-route-subjectId="0" class="action-link d-none" data-target="#models" data-container="#treatment-container"></a>
        <partial name="Treatment" />
    </section>
    <section id="models" class="border-top">
        <a asp-action="Models" asp-route-subjectId="0" asp-route-drugId="0" class="action-link d-none" data-target="#simulation" data-container="#models-container"></a>
        <partial name="Models" />
    </section>
    <section id="simulation" class="border-top">
        <a asp-action="Simulation" asp-route-subjectId="0" asp-route-drugId="0" class="action-link d-none" data-target="#results" data-container="#simulation-container"></a>
        <partial name="Simulation" />
    </section>
    <section id="results" class="border-top">
        <a asp-action="Results" asp-route-subjectId="0" asp-route-drugId="0" class="action-link d-none" data-target="#results" data-container="#results-container"></a>
        <partial name="Results" />
    </section>
</div>

@section Scripts {
    <script>
        setupIndexPage();
    </script>
}

@section Footer {
    <footer class="bg-light border-top">
        <p class="p-3 mb-0">
            <small class="text-muted">
                @Html.Raw(_config["Manifest:CopyrightLine"])<br />
                @Html.Raw(_config["Manifest:AddressLine1"])<br />
                @Html.Raw(_config["Manifest:AddressLine2"])<br />
                @Html.Raw(_config["Manifest:AddressLine3"])
            </small>
        </p>
    </footer>
}