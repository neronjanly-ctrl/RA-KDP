*@
        <div id="assistant" class="position-fixed" style="bottom: -320px; right: 0; width: 320px; height: 320px; z-index: 100">
            <svg id="assistant-svg" width="320" height="320" viewBox="0 0 140 140">
            </svg>
        </div>
    }
    else
    {
        <div class="w-25 section-header">
            <h2>Run the Simulation</h2>
            <small class="text-muted">
                Please select your treatment first.
            </small>
        </div>
        <div class="my-5 bg-grids"></div>
    }
</div>